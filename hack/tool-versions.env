# Pinned versions of dev/CI tools, shared by the Makefile (via `include`) and
# .github/workflows/validate.yaml (loaded into $GITHUB_ENV by the
# .github/actions/tool-versions composite). Bump a version here once and both
# the local `make` targets and CI follow.
#
# Format rules (so both consumers parse it): one `KEY=value` per line, no
# spaces around `=`, values unquoted. Comment lines (`#`) and blanks are fine —
# the CI loader greps for KEY= lines, and make ignores `#` comments.
HELM_DOCS_VERSION=v1.14.2
HELM_UNITTEST_VERSION=v0.7.2
