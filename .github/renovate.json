{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chart)"
  ],
  "timezone": "America/Los_Angeles",
  "gitAuthor": "Kenny Luong <kluong@tenstorrent.com>",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "helmv3": {
    "managerFilePatterns": [
      "/^charts/tt-operator/Chart\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^charts/tt-operator/values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\n(?:[ \\t]*#[^\\n]*\\n)*[ \\t]*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tenstorrent/helm/**"],
      "commitMessageTopic": "{{depName}} subchart",
      "commitMessageAction": "bump"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/tenstorrent/helm/tt-telemetry",
        "ghcr.io/tenstorrent/tt-telemetry"
      ],
      "groupName": "tt-telemetry",
      "groupSlug": "tt-telemetry"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "/tmp/helm-docs --chart-search-root=charts"
    ],
    "fileFilters": [
      "charts/tt-operator/Chart.lock",
      "charts/tt-operator/charts/**",
      "charts/tt-operator/README.md"
    ],
    "executionMode": "update"
  }
}
